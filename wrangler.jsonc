{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blyxt",
  "main": "src/index.ts",
  "account_id": "90f565eb037373e6cd4d90f335439160",
  "compatibility_date": "2026-09-28",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blyxt",
      "database_id": "4d3b84b7-2b42-48b7-b475-ac9b97b9091b",
      "migrations_dir": "migrations"
    }
  ],
  // poll followed blygs (§12.3)
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    // public identity of the blyg; rslantonie.com/blyg/* is rewritten to this Worker by Vercel
    "ORIGIN": "https://rslantonie.com/blyg/",
    "SITE_TITLE": "mundane stem",
    "SITE_SUBTITLE": "a blyg by Russell Antonie Pasetes",
    "AUTHOR_NAME": "Russell Antonie Pasetes",
    "AUTHOR_URL": "https://rslantonie.com/",
    // from `bun run discover`; 0 means unset
    "TELEGRAM_CHAT_ID": "-1003932920900",
    "PUB_TOPIC_ID": "2",
    "SUB_TOPIC_ID": "3",
    "OWNER_USER_ID": "2046988413"
  }
  // secrets (wrangler secret put / .dev.vars): TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET
}
